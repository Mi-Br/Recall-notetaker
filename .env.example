# Recall.ai — https://recall.ai dashboard → API keys. Region must match the key.
RECALL_API_KEY=
RECALL_REGION=us-west-2          # us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
NOTES_MODEL=claude-opus-5

# Bot appearance / behaviour
BOT_NAME=Michail's Notetaker
TRANSCRIPT_LANGUAGE=en           # or "auto"
WAITING_ROOM_TIMEOUT=600         # seconds the bot waits to be admitted
NOONE_JOINED_TIMEOUT=600
EVERYONE_LEFT_TIMEOUT=30

# Where notes and raw transcripts are written
NOTES_DIR=notes
STATE_FILE=state/bots.json
